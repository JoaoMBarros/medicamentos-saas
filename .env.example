# Local PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/medicacao
DB_USERNAME=medicacao
DB_PASSWORD=change-me-locally

# OAuth2/OIDC provider (local Keycloak)
OIDC_JWK_SET_URI=http://localhost:8081/realms/medicacao/protocol/openid-connect/certs
OIDC_ISSUER_URI=http://localhost:8081/realms/medicacao
OIDC_AUDIENCE=medicacao-api

# Local Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally

# Hikari connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=1800000

# Docker Compose PostgreSQL
POSTGRES_DB=medicacao
POSTGRES_USER=medicacao
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
